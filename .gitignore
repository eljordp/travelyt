# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# supabase
/supabase/.temp/
/supabase/.branches/

# typescript
*.tsbuildinfo
next-env.d.ts

# Internal pitches, LOIs, attorney briefs, and restricted operating material do
# not belong in this public repo. The custody folder is deliberately limited to
# sanitized, public-source product controls and an inactive applicability annex.
docs/
!docs/
docs/*
!docs/custody/
!docs/custody/*.md

# emergency ops exports contain live customer/job PII
ops-backups/

# Capacitor native artifacts
/ios/App/Pods/
/ios/App/build/
/ios/App/App.xcworkspace/xcuserdata/
/ios/App/App.xcodeproj/xcuserdata/
/ios/DerivedData/
/android/.gradle/
/android/build/
/android/app/build/
/android/local.properties
/android/.idea/
/android/captures/
